# App secrets
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/fraudlens.db
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_START=true
DEMO_MODE=true
COOKIE_SECURE=false

# AI provider (để trống = dùng template offline)
AI_ENABLED=true
AI_PROVIDER=auto
AI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
